---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}

const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---

<section class="page-hero">
  <div class="speed-lines" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Omrvinková navigácia">
          <ol>
            {crumbs.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
      )
    }
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-dark);
    padding-block: clamp(44px, 7vw, 88px);
  }

  .page-hero__inner {
    position: relative;
  }

  .page-hero h1 {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    max-width: 900px;
  }

  .page-hero .lead {
    max-width: 720px;
    margin: 0;
    color: #d7dbdf;
  }

  .page-hero .eyebrow {
    color: var(--accent);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--on-dark-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.6;
  }

  .crumbs a {
    color: var(--on-dark);
  }
</style>
