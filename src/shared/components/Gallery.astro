---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export interface Photo {
  src: ImageMetadata;
  alt: string;
  /** Span the whole row – for panoramas */
  full?: boolean;
}

interface Props {
  photos: Photo[];
  /** Show the first photo as a large tile – only for photos wide enough to stay sharp */
  featureFirst?: boolean;
}

const { photos, featureFirst = true } = Astro.props;
---

<ul class="gallery">
  {
    photos.map((photo, i) => (
      <li
        class:list={[
          'gallery__item',
          { 'gallery__item--wide': featureFirst && i === 0, 'gallery__item--full': photo.full },
        ]}
      >
        <Picture
          src={photo.src}
          alt={photo.alt}
          formats={['avif', 'webp']}
          widths={[400, 800, 1200, 1800].filter((w) => w <= photo.src.width)}
          sizes={
            photo.full
              ? '(max-width: 1240px) 100vw, 1180px'
              : featureFirst && i === 0
                ? '(max-width: 700px) 100vw, 66vw'
                : '(max-width: 700px) 100vw, 33vw'
          }
          loading="lazy"
          decoding="async"
        />
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(180px, 22vw, 260px);
    gap: clamp(10px, 1.6vw, 16px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink-2);
  }

  .gallery__item--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery__item--full {
    grid-column: 1 / -1;
    grid-row: span 2;
  }

  .gallery__item :global(picture),
  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
  }

  .gallery__item :global(img) {
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gallery__item:hover :global(img) {
    transform: scale(1.04);
  }

  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
    }

    .gallery__item--wide,
    .gallery__item--full {
      grid-column: span 2;
      grid-row: span 1;
      height: 240px;
    }
  }
</style>
