---
import type { CategoryGroup } from '../data/catalog';

interface Props {
  groups: CategoryGroup[];
}

const { groups } = Astro.props;
---

<nav class="toc" aria-label="Kategórie sortimentu">
  <ul>
    {groups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
  </ul>
</nav>

{
  groups.map((group, gi) => (
    <section class:list={['section', { 'section--white': gi % 2 === 1 }]} id={group.id} aria-labelledby={`${group.id}-title`}>
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{String(gi + 1).padStart(2, '0')}</span>
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p>{group.intro}</p>
        </div>
        <ul class="cats grid grid--3">
          {group.items.map((item) => (
            <li class="card cat">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              {item.brands && (
                <ul class="cat__brands" aria-label={`Značky – ${item.name}`}>
                  {item.brands.map((b) => (
                    <li>{b}</li>
                  ))}
                  <li class="cat__more">a ďalšie</li>
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))
}

<style>
  .toc {
    position: sticky;
    top: 76px;
    z-index: 10;
    background: var(--card);
    border-bottom: 1px solid var(--line);
  }

  .toc ul {
    display: flex;
    gap: 6px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 10px var(--gutter);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .toc a {
    display: block;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .toc a:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .cats {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cat {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-top: 4px solid var(--accent);
  }

  .cat h3 {
    font-size: 1.5rem;
    text-transform: uppercase;
  }

  .cat p {
    color: var(--muted);
  }

  .cat__brands {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .cat__brands li {
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .cat__brands .cat__more {
    background: none;
    color: var(--muted);
    font-weight: 500;
  }
</style>
