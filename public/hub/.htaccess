# peleton.sk – rozcestník + presmerovanie starých adries

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS (hosting je za proxy, preto X-Forwarded-Proto)
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # www -> bez www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # ---- Staré adresy predajne Šport (sport.php?contid=...) ----
    RewriteCond %{QUERY_STRING} (^|&)contid=sortiment(&|$) [NC]
    RewriteRule ^sport\.php$ https://sport.peleton.sk/sortiment/? [R=301,L]

    RewriteCond %{QUERY_STRING} (^|&)contid=(kontakt|otvaracie[-_]hodiny)(&|$) [NC]
    RewriteRule ^sport\.php$ https://sport.peleton.sk/kontakt/? [R=301,L]

    RewriteRule ^sport\.php$ https://sport.peleton.sk/? [R=301,L]

    # ---- Staré adresy Mototechny ----
    RewriteRule ^mototechna-sortiment\.php$ https://mototechna.peleton.sk/sortiment/? [R=301,L]
    RewriteRule ^mototechna-sluzby\.php$ https://mototechna.peleton.sk/sluzby/? [R=301,L]
    RewriteRule ^mototechna-(kontakt|otvaracie-hodiny)\.php$ https://mototechna.peleton.sk/kontakt/? [R=301,L]
    RewriteRule ^mototechna(-predajna)?\.php$ https://mototechna.peleton.sk/? [R=301,L]

    RewriteRule ^index\.php$ /? [R=301,L]

    # ---- Starý web: administrácia, editor a podvrhnuté (spam) stránky – natrvalo preč ----
    RewriteRule ^(admin|fckeditored|userfiles|databazy|inc|images)(/|$) - [G,L]
    RewriteRule ^(list-slutert|down|nieco|notify|captcha|404|_matomo|_mototechna-nav)\.php$ - [G,L]
    RewriteRule \.php$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Súbory v /_astro/ majú hash v názve – môžu sa cachovať natrvalo
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
