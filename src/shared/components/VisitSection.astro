---
import ContactList from './ContactList.astro';
import MapEmbed from './MapEmbed.astro';
import OpeningHours from './OpeningHours.astro';
import type { Business } from '../data/business';

interface Props {
  business: Business;
  /** Heading level of the section title – h1 on the contact page, h2 elsewhere */
  as?: 'h1' | 'h2';
  title?: string;
  intro?: string;
}

const { business, as: Heading = 'h2', title = 'Navštívte nás', intro } = Astro.props;
---

<section class="section section--white visit" id="kontakt" aria-labelledby="visit-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Kontakt · {business.address.city}</span>
      <Heading id="visit-title">{title}</Heading>
      {intro && <p>{intro}</p>}
    </div>

    <div class="visit__grid">
      <div class="visit__info">
        <div class="card visit__card">
          <h3>Otváracie hodiny</h3>
          <OpeningHours business={business} />
        </div>
        <div class="card visit__card">
          <h3>Kontakt</h3>
          <ContactList business={business} />
        </div>
      </div>
      <MapEmbed business={business} />
    </div>
  </div>
</section>

<style>
  .visit__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(16px, 2.4vw, 24px);
    align-items: stretch;
  }

  .visit__info {
    display: grid;
    gap: clamp(16px, 2.4vw, 24px);
  }

  .visit__card {
    padding: clamp(20px, 3vw, 32px);
  }

  .visit__card h3 {
    font-size: 1.6rem;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .visit__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
